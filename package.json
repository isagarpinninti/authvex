{
  "name": "authvex",
  "version": "0.1.0",
  "private": true,
  "description": "Authvex monorepo: a self-hosted hardware-bound identity, passkey and zero-trust session engine with no third-party auth libraries.",
  "scripts": {
    "dev": "next dev",
    "build:packages": "npm run build -w @authvex/core && npm run build -w @authvex/react",
    "build:studio": "STUDIO_EXPORT=1 next build && node scripts/copy-studio.mjs",
    "build": "npm run build:packages && npm run build:studio && npm run build -w @authvex/cli",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.interop.json && npm run typecheck -w @authvex/core -w @authvex/react -w @authvex/cli",
    "lint": "eslint .",
    "test": "npm run test -w @authvex/core -w @authvex/react -w @authvex/cli",
    "e2e": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:webkit": "playwright test --project=webkit",
    "load": "node --expose-gc scripts/load.mjs",
    "e2e:browsers": "npm run e2e && npm run e2e:firefox && npm run e2e:webkit",
    "bench": "node scripts/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run build && npm run interop && npm run e2e && npm run smoke",
    "interop": "vitest run -c vitest.interop.config.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "Sagar Pinninti",
    "url": "https://github.com/isagarpinninti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isagarpinninti/authvex.git"
  },
  "homepage": "https://github.com/isagarpinninti/authvex#readme",
  "bugs": {
    "url": "https://github.com/isagarpinninti/authvex/issues"
  },
  "dependencies": {
    "@authvex/core": "*",
    "@authvex/react": "*",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^1.19.17",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.7",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "jsdom": "^29.1.1",
    "openid-client": "^6.8.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
